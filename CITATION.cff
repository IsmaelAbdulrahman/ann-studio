    email: "ismael.abdulrahman@epu.edu.iq"
    affiliation: "Tennessee Technological University, USA"
version: "2.0"
date-released: "2026-08-12"
license: CC-BY-4.0
url: "https://github.com/IsmaelAbdulrahman/ann-studio"
repository-code: "https://github.com/IsmaelAbdulrahman/ann-studio"
keywords:
  - artificial neural networks
  - deep learning
  - machine learning
  - PyTorch
  - NumPy
  - education
  - textbook
